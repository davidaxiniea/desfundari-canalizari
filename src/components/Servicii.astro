---
/*
  Secțiunea centrală: 6 servicii în carduri, fiecare cu poză, icon line,
  descriere concretă și micro-verdict în vocea brandului.

  Pozele: 4 sunt REALE (de pe profilul de Google Business al firmei), 2 sunt
  ilustrații stock gratuite (Pexels) pentru serviciile fără poză proprie —
  marcate mai jos cu `stock: true`. Nu sunt prezentate ca lucrări ale firmei;
  afirmația „lucrările noastre" apare doar în galerie, unde totul e real.
  Toate trec prin gradul comun de culoare (`.duotone`), iar cele stock primesc
  în plus clasa `.e-stock` — puțin mai desaturate, ca să intre în paleta
  cadrelor reale, care sunt făcute pe stradă, în lumină rece.
*/
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Eyebrow from './Eyebrow.astro';
import { FIRMA } from '../lib/firma';

import fotoDesfundari from '../assets/servicii/desfundari.jpg';
import fotoInspectie from '../assets/servicii/inspectie-video.jpg';
import fotoReparatii from '../assets/servicii/reparatii.jpg';
import fotoCuratare from '../assets/servicii/curatare-tevi.jpg';
import fotoVidanjare from '../assets/servicii/vidanjare.jpg';
import fotoNonStop from '../assets/servicii/non-stop.jpg';

const servicii = [
  {
    icon: 'pompa',
    titlu: 'Desfundări canalizare',
    text: 'Deblocăm chiuvete, WC-uri, coloane de bloc și rețele exterioare. Orice blocaj, orice diametru.',
    verdict: 'Curge.',
    foto: fotoDesfundari,
    alt: 'Intervenție de desfundare canalizare la un cămin, București',
    stock: false,
  },
  {
    icon: 'camera',
    titlu: 'Inspecție video canalizare',
    text: 'Camera intră în țeavă și vezi pe ecran exact unde e problema. Fără spart pe ghicite.',
    verdict: 'Clar.',
    foto: fotoInspectie,
    alt: 'Interiorul unui cămin de canalizare, verificat înainte de intervenție',
    stock: false,
  },
  {
    icon: 'cheie',
    titlu: 'Reparații canalizare',
    text: 'Înlocuim țevile sparte, refacem pantele și garniturile. Lăsăm totul curat în urmă.',
    verdict: 'Ține.',
    foto: fotoReparatii,
    alt: 'Lucrare de îmbinare și reparație a unui tronson de țeavă',
    stock: true,
  },
  {
    icon: 'jet',
    titlu: 'Curățare țevi',
    text: 'Spălăm țeava cu jet de mare presiune (hidrojet). Grăsimea și calcarul dispar de pe tot traseul.',
    verdict: 'Liber.',
    foto: fotoCuratare,
    alt: 'Curățare cu jet de apă sub presiune, hidrojet profesional',
    stock: false,
  },
  {
    icon: 'camion',
    titlu: 'Vidanjare',
    text: 'Golim fose septice, bazine și separatoare de grăsimi. Venim cu utilajul nostru, pe programul tău.',
    verdict: 'Gol.',
    foto: fotoVidanjare,
    alt: 'Cisternă de vidanjare în timpul unei operațiuni de golire',
    stock: true,
  },
  {
    icon: 'luna',
    titlu: 'Non-stop 24/7',
    text: 'Noapte, weekend, sărbători — venim oricând, la același preț. Fără taxe de urgență.',
    verdict: 'Venim.',
    foto: fotoNonStop,
    alt: 'Duba de intervenție desfundări canalizare, gata de plecare',
    stock: false,
  },
] as const;
---

<section id="servicii" class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
  <div data-reveal>
    <Eyebrow num="03" text="Servicii" />
    <h2 class="mt-4 max-w-2xl text-h2">Ce rezolvăm.</h2>
    <p class="mt-4 max-w-2xl text-muted-light">
      Orice problemă de canalizare, de la chiuveta de acasă la rețeaua unui restaurant. La fel de
      fiecare dată: vedem, spunem prețul, rezolvăm.
    </p>
  </div>

  <div class="mt-10 grid gap-4 md:grid-cols-2 md:gap-6">
    {
      servicii.map((s) => (
        <article
          class="card-industrial colturi card-tilt duotone-hover flex flex-col overflow-hidden bg-abur"
          data-reveal
        >
          <span class:list={['duotone block', s.stock && 'e-stock']}>
            <Image
              src={s.foto}
              alt={s.alt}
              widths={[400, 700, 1000]}
              sizes="(min-width: 768px) 50vw, 100vw"
              class="aspect-[16/9] h-auto w-full object-cover"
              loading="lazy"
            />
          </span>

          <div class="flex grow flex-col p-6 md:p-8">
            <Icon name={s.icon} class="h-7 w-7" />
            <h3 class="mt-4 text-h3">{s.titlu}</h3>
            <p class="mt-2 grow text-muted-light">{s.text}</p>
            <p class="mt-3 font-medium">{s.verdict}</p>

            {/* py-1.5 duce zona de atingere peste pragul WCAG de 24px */}
            <div class="mt-5 flex items-center gap-5 border-t border-portelan pt-2.5 text-caption">
              <a class="link-discret py-1.5 font-medium" href="#contact">
                Cere ofertă
              </a>
              <a class="link-discret py-1.5 font-mono font-medium" href={`tel:${FIRMA.telefonPrincipal.tel}`} data-track="telefon">
                {FIRMA.telefonPrincipal.afisare}
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  // Tilt 3D subtil pe carduri — doar pe device-uri cu hover și fără reduced-motion
  if (window.matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    document.querySelectorAll<HTMLElement>('.card-tilt').forEach((card) => {
      card.addEventListener('pointerenter', () => {
        card.style.transition = 'transform 150ms ease-out';
      });
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        card.style.transform = `perspective(700px) rotateX(${(-y * 3).toFixed(2)}deg) rotateY(${(x * 3).toFixed(2)}deg) translateY(-2px)`;
      });
      card.addEventListener('pointerleave', () => {
        card.style.transition = 'transform 300ms ease-out';
        card.style.transform = '';
        card.addEventListener('transitionend', () => (card.style.transition = ''), { once: true });
      });
    });
  }
</script>

<style>
  .link-discret {
    color: var(--color-petrol);
    text-underline-offset: 4px;
    transition: opacity var(--dur-quick) var(--ease-flux);
  }
  .link-discret:hover {
    text-decoration: underline;
    opacity: 0.8;
  }
  .link-discret:active {
    opacity: 0.65;
  }
</style>
