---
/*
  Galerie de lucrări: 3 slidere interactive înainte/după (tragi de mâner și
  vezi diferența) + 3 poze cu lightbox nativ (<dialog>, zero librării).

  INSTRUCȚIUNI ÎNLOCUIRE POZE (pentru client / la predare):
  1. Pune pozele reale în `src/assets/galerie/` — JPG, orientare peisaj,
     ideal 1200×900 (4:3), sub 500KB fiecare. Build-ul le optimizează automat
     (WebP, lazy, dimensiuni responsive).
  2. Pentru slidere: actualizează lista `perechi` (poza înainte + poza după,
     făcute din același unghi — altfel comparația nu are efect).
  3. Pentru pozele simple: lista `simple`, cu alt descriptiv + local (SEO).
*/
import { Image } from 'astro:assets';
import { getImage } from 'astro:assets';
import BeforeAfter from './BeforeAfter.astro';
import Eyebrow from './Eyebrow.astro';

import coloanaInainte from '../assets/galerie/TODO-desfundare-coloana-inainte.jpg';
import coloanaDupa from '../assets/galerie/TODO-desfundare-coloana-dupa.jpg';
import hidrojetInainte from '../assets/galerie/TODO-hidrojet-exterior-inainte.jpg';
import hidrojetDupa from '../assets/galerie/TODO-hidrojet-exterior-dupa.jpg';
import inspectieInainte from '../assets/galerie/TODO-inspectie-video-inainte.jpg';
import inspectieDupa from '../assets/galerie/TODO-inspectie-video-dupa.jpg';
import echipa from '../assets/galerie/TODO-echipa-la-lucru.jpg';
import echipament from '../assets/galerie/TODO-echipament-hidrojet.jpg';
import duba from '../assets/galerie/TODO-duba-echipata.jpg';
import Icon from './Icon.astro';

// TODO: înlocuiește pozele placeholder cu lucrări reale (vezi instrucțiunile de sus)
const perechi = [
  {
    inainte: coloanaInainte,
    dupa: coloanaDupa,
    altInainte: 'Coloană de bloc înfundată, înainte de intervenție, București',
    altDupa: 'Coloană de bloc desfundată și funcțională, București',
    eticheta: 'Desfundare coloană de bloc',
  },
  {
    inainte: hidrojetInainte,
    dupa: hidrojetDupa,
    altInainte: 'Canalizare exterioară cu depuneri, înainte de curățarea cu hidrojet, Ilfov',
    altDupa: 'Canalizare exterioară curățată cu hidrojet, Ilfov',
    eticheta: 'Curățare cu hidrojet',
  },
  {
    inainte: inspectieInainte,
    dupa: inspectieDupa,
    altInainte: 'Blocaj identificat la inspecția video a canalizării, București',
    altDupa: 'Traseu de canalizare liber, confirmat la inspecția video, București',
    eticheta: 'Inspecție video',
  },
];

const simple = [
  { src: echipa, alt: 'Echipă de desfundare canalizare la lucru, sector 3 București' },
  { src: echipament, alt: 'Echipament hidrojet profesional pentru curățare țevi' },
  { src: duba, alt: 'Dubă de intervenție Desfundări Canalizări, București și Ilfov' },
];

// Variante mari pentru lightbox, optimizate la build
const mari = await Promise.all(
  simple.map((i) => getImage({ src: i.src, width: 1600, format: 'webp' })),
);
---

<section id="galerie" class="bg-petrol text-portelan">
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
    <div data-reveal>
      <Eyebrow num="02" text="Lucrări" tone="dark" />
      <h2 class="mt-4 max-w-2xl text-h2">Înainte și după. Trage și compară.</h2>
      <p class="mt-4 max-w-2xl text-muted-dark">
        Poze din lucrările noastre, nu din stock. Trage de mânerul din mijloc ca să vezi diferența.
      </p>
    </div>

    {/* Sliderele înainte/după — vând cel mai bine la desfundări */}
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {
        perechi.map((p) => (
          <figure data-reveal>
            <BeforeAfter inainte={p.inainte} dupa={p.dupa} altInainte={p.altInainte} altDupa={p.altDupa} />
            <figcaption class="mt-2 text-caption text-muted-dark">{p.eticheta}</figcaption>
          </figure>
        ))
      }
    </div>

    {/* Pozele simple, cu lightbox */}
    <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
      {
        simple.map((img, i) => (
          <button
            type="button"
            class="poza colturi group rounded-ui relative overflow-hidden"
            data-index={i}
            aria-label={`Mărește imaginea: ${img.alt}`}
          >
            <Image
              src={img.src}
              alt={img.alt}
              widths={[400, 800, 1200]}
              sizes="(min-width: 768px) 33vw, 50vw"
              class="aspect-[4/3] h-auto w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </button>
        ))
      }
    </div>
  </div>
</section>

{/* Lightbox: dialog nativ — Esc închide implicit, focus rămâne captiv în dialog */}
<dialog id="lightbox" class="rounded-ui m-auto w-[min(96vw,72rem)] bg-petrol p-3 backdrop:bg-petrol/80 md:p-4">
  <img id="lightbox-img" class="max-h-[80vh] w-full rounded-[3px] object-contain" src="" alt="" />
  <div class="mt-3 flex items-center justify-between gap-4">
    <p id="lightbox-caption" class="text-caption text-muted-dark"></p>
    <div class="flex gap-2">
      <button type="button" class="lb-btn" data-lb="prev" aria-label="Imaginea anterioară">
        <Icon name="stanga" class="h-5 w-5" />
      </button>
      <button type="button" class="lb-btn" data-lb="next" aria-label="Imaginea următoare">
        <Icon name="dreapta" class="h-5 w-5" />
      </button>
      <button type="button" class="lb-btn" data-lb="close" aria-label="Închide galeria">
        <Icon name="inchide" class="h-5 w-5" />
      </button>
    </div>
  </div>
</dialog>

<script define:vars={{ mari: mari.map((m) => m.src), alturi: simple.map((i) => i.alt) }}>
  const dialog = document.getElementById('lightbox');
  const img = document.getElementById('lightbox-img');
  const caption = document.getElementById('lightbox-caption');
  let curent = 0;

  const arata = (i) => {
    curent = (i + mari.length) % mari.length;
    img.src = mari[curent];
    img.alt = alturi[curent];
    caption.textContent = alturi[curent];
  };

  document.querySelectorAll('.poza').forEach((btn) => {
    btn.addEventListener('click', () => {
      arata(Number(btn.dataset.index));
      dialog.showModal();
    });
  });

  dialog.querySelector('[data-lb="prev"]').addEventListener('click', () => arata(curent - 1));
  dialog.querySelector('[data-lb="next"]').addEventListener('click', () => arata(curent + 1));
  dialog.querySelector('[data-lb="close"]').addEventListener('click', () => dialog.close());

  // Săgeți stânga/dreapta pentru navigare; Esc închide nativ
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') arata(curent - 1);
    if (e.key === 'ArrowRight') arata(curent + 1);
  });

  // Click pe fundalul întunecat închide dialogul
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .lb-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    width: 2.5rem;
    border-radius: var(--radius-ui);
    color: var(--color-portelan);
    border: 1px solid color-mix(in srgb, var(--color-portelan) 30%, var(--color-petrol));
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-portelan) 15%, transparent);
    transition:
      border-color var(--dur-quick) var(--ease-flux),
      opacity var(--dur-quick) var(--ease-flux);
  }
  .lb-btn:hover {
    border-color: var(--color-portelan);
  }
  .lb-btn:active {
    opacity: 0.7;
  }

  /* Colțarele tehnice trebuie să rămână peste imagine */
  .poza.colturi::before,
  .poza.colturi::after {
    z-index: 1;
    border-color: color-mix(in srgb, var(--color-portelan) 85%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .poza :global(img) {
      transition: none;
    }
  }
</style>
