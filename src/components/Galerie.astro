---
/*
  Galerie — POZE REALE ale firmei, preluate de pe profilul ei de Google Business
  („De la proprietar", deci ale firmei de drept). Fără stock aici: secțiunea
  afirmă că sunt lucrările noastre, deci trebuie să fie adevărat.

  Nu există perechi înainte/după, așa că nu folosim sliderul de comparație
  (componenta `BeforeAfter.astro` rămâne în repo pentru când clientul trimite perechi reale).

  Tratament: duotone petrol în grilă (armonie cu restul paginii), culoare reală
  la hover și în lightbox — poza autentică rămâne verificabilă.

  ÎNLOCUIRE / ADĂUGARE POZE:
  1. Pune JPG-uri peisaj în `src/assets/galerie/` (ideal 1200×900, sub 500KB).
  2. Adaugă-le în lista `poze` de mai jos, cu `alt` descriptiv + localitate (contează la SEO).
*/
import { Image, getImage } from 'astro:assets';
import Eyebrow from './Eyebrow.astro';
import Icon from './Icon.astro';

import echipaLaCamin from '../assets/galerie/lucrare-echipa-la-camin.jpg';
import hidrojet from '../assets/galerie/lucrare-hidrojet-presiune.jpg';
import echipament from '../assets/galerie/lucrare-echipament-hidrojet-duba.jpg';
import furtunInCamin from '../assets/galerie/lucrare-furtun-in-camin.jpg';
import doiTehnicieni from '../assets/galerie/lucrare-doi-tehnicieni.jpg';
import dubaBrenduita from '../assets/galerie/lucrare-duba-brenduita.jpg';

// Șase cadre distincte (echipă, hidrojet, echipament, cămin, dubă) — preferăm
// varietatea în locul umpluturii: pozele clientului provin din aceleași intervenții.
const poze = [
  { src: echipaLaCamin, alt: 'Echipă de desfundare canalizare la un cămin de vizitare, București' },
  { src: hidrojet, alt: 'Curățare canalizare cu jet de apă sub presiune (hidrojet), București' },
  { src: echipament, alt: 'Echipament hidrojet cu tambur de furtun, montat în duba de intervenție' },
  { src: furtunInCamin, alt: 'Furtun de desfundare introdus în căminul de canalizare' },
  { src: doiTehnicieni, alt: 'Doi tehnicieni desfundă canalizarea la un cămin de vizitare' },
  { src: dubaBrenduita, alt: 'Duba de intervenție pentru desfundări și inspecție video canalizare' },
];

// Variante mari pentru lightbox (culoare reală), optimizate la build
const mari = await Promise.all(poze.map((p) => getImage({ src: p.src, width: 1600, format: 'webp' })));
---

<section id="galerie" class="bg-petrol text-portelan">
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
    <div data-reveal>
      <Eyebrow num="02" text="Lucrări" tone="dark" />
      <h2 class="mt-4 max-w-2xl text-h2">Din lucrările noastre.</h2>
      <p class="mt-4 max-w-2xl text-muted-dark">
        Poze reale din intervenții în București și Ilfov. Apasă pe o poză ca s-o vezi mare, la culoare.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
      {
        poze.map((p, i) => (
          <button
            type="button"
            class="poza colturi duotone-hover rounded-ui relative overflow-hidden"
            data-index={i}
            aria-label={`Mărește imaginea: ${p.alt}`}
            data-reveal
          >
            <span class="duotone block">
              <Image
                src={p.src}
                alt={p.alt}
                widths={[400, 800, 1200]}
                sizes="(min-width: 768px) 33vw, 50vw"
                class="aspect-[4/3] h-auto w-full object-cover"
                loading="lazy"
              />
            </span>
          </button>
        ))
      }
    </div>
  </div>
</section>

{/* Lightbox: dialog nativ — Esc închide implicit, focus captiv. Poza se vede la culoare reală. */}
<dialog id="lightbox" class="rounded-ui m-auto w-[min(96vw,72rem)] bg-petrol p-3 backdrop:bg-petrol/80 md:p-4">
  <img id="lightbox-img" class="max-h-[80vh] w-full rounded-[3px] object-contain" src="" alt="" />
  <div class="mt-3 flex items-center justify-between gap-4">
    <p id="lightbox-caption" class="text-caption text-muted-dark"></p>
    <div class="flex shrink-0 gap-2">
      <button type="button" class="lb-btn" data-lb="prev" aria-label="Imaginea anterioară">
        <Icon name="stanga" class="h-5 w-5" />
      </button>
      <button type="button" class="lb-btn" data-lb="next" aria-label="Imaginea următoare">
        <Icon name="dreapta" class="h-5 w-5" />
      </button>
      <button type="button" class="lb-btn" data-lb="close" aria-label="Închide galeria">
        <Icon name="inchide" class="h-5 w-5" />
      </button>
    </div>
  </div>
</dialog>

<script define:vars={{ mari: mari.map((m) => m.src), alturi: poze.map((p) => p.alt) }}>
  const dialog = document.getElementById('lightbox');
  const img = document.getElementById('lightbox-img');
  const caption = document.getElementById('lightbox-caption');
  let curent = 0;

  const arata = (i) => {
    curent = (i + mari.length) % mari.length;
    img.src = mari[curent];
    img.alt = alturi[curent];
    caption.textContent = alturi[curent];
  };

  document.querySelectorAll('.poza').forEach((btn) => {
    btn.addEventListener('click', () => {
      arata(Number(btn.dataset.index));
      dialog.showModal();
    });
  });

  dialog.querySelector('[data-lb="prev"]').addEventListener('click', () => arata(curent - 1));
  dialog.querySelector('[data-lb="next"]').addEventListener('click', () => arata(curent + 1));
  dialog.querySelector('[data-lb="close"]').addEventListener('click', () => dialog.close());

  // Săgeți stânga/dreapta pentru navigare; Esc închide nativ
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') arata(curent - 1);
    if (e.key === 'ArrowRight') arata(curent + 1);
  });

  // Click pe fundalul întunecat închide dialogul
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .lb-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    width: 2.5rem;
    border-radius: var(--radius-ui);
    color: var(--color-portelan);
    border: 1px solid color-mix(in srgb, var(--color-portelan) 30%, var(--color-petrol));
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-portelan) 15%, transparent);
    transition:
      border-color var(--dur-quick) var(--ease-flux),
      opacity var(--dur-quick) var(--ease-flux);
  }
  .lb-btn:hover {
    border-color: var(--color-portelan);
  }
  .lb-btn:active {
    opacity: 0.7;
  }

  /* Colțarele tehnice stau peste poză */
  .poza.colturi::before,
  .poza.colturi::after {
    z-index: 1;
    border-color: color-mix(in srgb, var(--color-portelan) 85%, transparent);
  }

  /* Zoom discret la hover, peste dezvăluirea culorii */
  .poza :global(img) {
    transition:
      filter var(--dur-reveal) var(--ease-flux),
      transform var(--dur-reveal) var(--ease-flux);
  }
  @media (hover: hover) {
    .poza:hover :global(img) {
      transform: scale(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .poza :global(img) {
      transition: none;
    }
  }
</style>
