---
/*
  Bara sticky de apel — elementul #1 de conversie pe mobil.
  Un singur buton mare, mereu la un tap distanță. Dispare pe desktop
  (acolo numărul stă în header).
*/
import Icon from './Icon.astro';
import { FIRMA } from '../lib/firma';
---

<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-abur bg-portelan/95 p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] backdrop-blur md:hidden"
>
  <a href={`tel:${FIRMA.telefonPrincipal.tel}`} class="btn-semnal w-full text-h3">
    <Icon name="telefon" class="h-5 w-5" />
    Sună acum · <span class="font-mono">{FIRMA.telefonPrincipal.afisare}</span>
  </a>
</div>
