---
/*
  Slider de comparație înainte/după: tragi de mâner și vezi diferența.
  Input range invizibil peste toată suprafața → accesibil din tastatură
  (săgeți stânga/dreapta) și natural la drag pe touch/mouse.
*/
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  inainte: ImageMetadata;
  dupa: ImageMetadata;
  altInainte: string;
  altDupa: string;
}
const { inainte, dupa, altInainte, altDupa } = Astro.props;
---

<div class="ba colturi relative aspect-[4/3] touch-pan-y overflow-hidden rounded-ui select-none" style="--pos: 50%">
  {/* Stratul de jos: DUPĂ (rezultatul) */}
  <Image
    src={dupa}
    alt={altDupa}
    widths={[400, 800, 1200]}
    sizes="(min-width: 768px) 33vw, 100vw"
    class="absolute inset-0 h-full w-full object-cover"
    loading="lazy"
  />
  {/* Stratul de sus: ÎNAINTE, decupat până la poziția mânerului */}
  <div class="absolute inset-0" style="clip-path: inset(0 calc(100% - var(--pos)) 0 0)">
    <Image
      src={inainte}
      alt={altInainte}
      widths={[400, 800, 1200]}
      sizes="(min-width: 768px) 33vw, 100vw"
      class="absolute inset-0 h-full w-full object-cover"
      loading="lazy"
    />
  </div>

  {/* Mânerul: linie + buton rotund cu săgeți */}
  <div class="maner pointer-events-none absolute inset-y-0" style="left: var(--pos)" aria-hidden="true">
    <div class="linie"></div>
    <div class="buton">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
        <polyline points="9 18 3 12 9 6"></polyline>
        <polyline points="15 18 21 12 15 6"></polyline>
      </svg>
    </div>
  </div>

  <span class="chip absolute top-2.5 left-2.5">Înainte</span>
  <span class="chip absolute top-2.5 right-2.5">După</span>

  <input
    type="range"
    min="0"
    max="100"
    value="50"
    step="1"
    class="ba-range absolute inset-0 h-full w-full cursor-ew-resize opacity-0"
    aria-label={`Compară înainte și după: ${altDupa}`}
  />
</div>

<style>
  .chip {
    border-radius: var(--radius-ui);
    background-color: color-mix(in srgb, var(--color-petrol) 88%, transparent);
    color: var(--color-portelan);
    padding: 0.2rem 0.6rem;
    font-size: var(--text-caption);
    font-weight: 500;
  }
  .maner {
    transform: translateX(-50%);
  }
  .linie {
    position: absolute;
    inset: 0 auto;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background-color: var(--color-portelan);
    box-shadow: 0 0 6px color-mix(in srgb, var(--color-petrol) 45%, transparent);
  }
  .buton {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background-color: var(--color-portelan);
    color: var(--color-petrol);
    border: 1px solid var(--muchie-light);
    box-shadow:
      inset 0 1px 0 #fff0,
      0 2px 8px -1px color-mix(in srgb, var(--color-petrol) 40%, transparent);
    transition: transform var(--dur-quick) var(--ease-flux);
  }
  /* Mânerul „răspunde" cât timp tragi de el */
  .ba:has(.ba-range:active) .buton,
  .ba:has(.ba-range:focus-visible) .buton {
    transform: translate(-50%, -50%) scale(1.12);
  }
  .ba:has(.ba-range:focus-visible) .linie {
    background-color: var(--color-semnal);
  }
</style>

<script>
  // Mută mânerul: un singur listener pe input, poziția intră prin CSS var
  document.querySelectorAll<HTMLInputElement>('.ba-range').forEach((range) => {
    range.addEventListener('input', () => {
      range.parentElement!.style.setProperty('--pos', `${range.value}%`);
    });
  });
</script>
