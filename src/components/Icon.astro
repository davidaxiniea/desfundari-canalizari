  dreapta: `<polyline points="9 18 15 12 9 6"/>`,
} as const;

const { name, class: className = 'h-5 w-5' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>
