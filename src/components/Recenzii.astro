---
/*
  Dovadă socială: 3 recenzii REALE de pe profilul Google Business al firmei
  (extrase în iulie 2026; toate cele 18 recenzii sunt de 5 stele).
  Nu se inventează și nu se modifică sensul: singurele intervenții sunt
  diacriticele și punctuația, iar prima recenzie e citată ca extras.
*/
import Icon from './Icon.astro';
import Eyebrow from './Eyebrow.astro';
import { FIRMA } from '../lib/firma';

const recenzii = [
  {
    text: 'Colaborez de ceva vreme cu această firmă. O echipă de toată pomina, dl. Viorel, dl. Gabi și dl. Sile sunt profesioniști în tot ceea ce fac. Nu pleacă până nu îți rezolvă problema pentru care au fost solicitați. La desfundări în principiu nu se dă garanție, dar dacă lucrezi cu ei poți avea garanția desfundării sau a canalizării pe care ei au intervenit. Totul la superlativ.',
    autor: 'Andrei Macovei',
    meta: 'Ghid local Google',
  },
  {
    text: 'Seriozitate, punctualitate, calitate, prețuri avantajoase.',
    autor: 'Ionuț Clătici',
    meta: 'Ghid local Google',
  },
  {
    text: 'Super profesioniști, rapizi. Examinează problema repede, nu fac mizerie, sunt foarte curați.',
    autor: 'Mihai Bradu',
    meta: 'Recenzie Google',
  },
];
---

<section id="recenzii">
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
    <div data-reveal>
      <Eyebrow num="07" text="Recenzii" />
      <h2 class="mt-4 max-w-2xl text-h2">Ce spun clienții.</h2>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-3 md:gap-6">
      {
        recenzii.map((r) => (
          <figure class="card-industrial colturi flex flex-col bg-abur p-6" data-reveal>
            <div class="flex gap-1" role="img" aria-label="5 stele din 5">
              {Array.from({ length: 5 }).map(() => (
                <Icon name="stea" class="h-4 w-4 fill-petrol" />
              ))}
            </div>
            <blockquote class="mt-4 grow text-muted-light">{r.text}</blockquote>
            <figcaption class="mt-4 text-caption font-medium">{r.autor}</figcaption>
            <p class="text-caption text-muted-light">{r.meta}</p>
          </figure>
        ))
      }
    </div>

    {/* TODO: pune link-ul real al profilului Google Business în src/lib/firma.ts */}
    <a
      href={FIRMA.googleBusinessUrl}
      target="_blank"
      rel="noopener"
      class="badge-google rounded-ui mt-8 inline-flex items-center gap-2 border border-gri-fonta px-5 py-2.5 text-caption font-medium"
      data-reveal
    >
      <Icon name="stea" class="h-4 w-4 fill-petrol" />
      {FIRMA.rating.valoare} · {FIRMA.rating.numarRecenzii} recenzii pe Google
    </a>
  </div>
</section>

<style>
  .badge-google {
    color: var(--color-petrol);
    transition:
      border-color var(--dur-quick) var(--ease-flux),
      background-color var(--dur-quick) var(--ease-flux);
  }
  .badge-google:hover {
    border-color: var(--color-petrol);
    background-color: var(--color-portelan);
  }
  .badge-google:active {
    background-color: var(--color-abur);
  }
</style>
