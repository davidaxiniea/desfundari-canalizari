---
/*
  Zone acoperite — tag-uri cu sectoarele și localitățile Ilfov (SEO local).
  Lista se editează în src/lib/firma.ts.
*/
import { ZONE_BUCURESTI, ZONE_ILFOV } from '../lib/firma';
import Icon from './Icon.astro';
import Eyebrow from './Eyebrow.astro';
---

<section id="zone" class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
  <div data-reveal>
    <Eyebrow num="05" text="Acoperire" />
    <h2 class="mt-4 max-w-2xl text-h2">București și Ilfov, complet.</h2>
    <p class="mt-4 max-w-2xl text-muted-light">
      Venim la tine oriunde în București și Ilfov: desfundare canalizare, curățare țevi,
      vidanjare. Același preț, indiferent de zonă.
    </p>
  </div>

  <div class="mt-10 grid gap-8 md:grid-cols-2" data-reveal>
    <div>
      <p class="flex items-center gap-2 text-caption font-medium">
        <Icon name="pin" class="h-4 w-4" /> București
      </p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {ZONE_BUCURESTI.map((z) => <li class="tag">{z}</li>)}
      </ul>
    </div>
    <div>
      <p class="flex items-center gap-2 text-caption font-medium">
        <Icon name="pin" class="h-4 w-4" /> Ilfov
      </p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {ZONE_ILFOV.map((z) => <li class="tag">{z}</li>)}
      </ul>
    </div>
  </div>

  <p class="mt-8 text-caption text-muted-light" data-reveal>
    Nu-ți găsești localitatea? Sună. Dacă e în Ilfov, ajungem.
  </p>
</section>

<style>
  .tag {
    border-radius: var(--radius-ui);
    border: 1px solid var(--muchie-light);
    background-color: var(--color-abur);
    color: var(--color-petrol);
    padding: 0.375rem 0.875rem;
    font-size: var(--text-caption);
    font-weight: 500;
    transition: transform var(--dur-quick) var(--ease-flux);
  }
  .tag:hover {
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .tag:hover {
      transform: none;
    }
  }
</style>
